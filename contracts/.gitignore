# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv files. The `.*` variants matter as much as the bare names: per-network
# files like script/.env.base_sepolia are a natural thing to create, they hold
# the same private keys, and neither `.env` nor `script/.env` matches them — so
# without these they sit untracked and one `git add .` away from being published.
.env
.env.*
script/.env
script/.env.*
# ...except the committed template, which the patterns above would otherwise
# swallow. It is already tracked so nothing breaks today, but re-adding it after
# a delete would silently do nothing.
!script/.env.example
did

broadcast/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
# Project-local venv for the script/ helpers; CI recreates it per run
.venv/

# OMC runtime
.omc/
