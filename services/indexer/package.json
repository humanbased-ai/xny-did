{
  "name": "xny-indexer",
  "license": "Apache-2.0",
  "scripts": {
    "codegen": "graph codegen",
    "build": "graph build",
    "build:base-sepolia": "graph build --network base-sepolia",
    "build:base": "graph build --network base",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "deploy": "graph deploy --node https://api.studio.thegraph.com/deploy/ did-base-sepolia",
    "deploy:base-sepolia": "graph deploy --node https://api.studio.thegraph.com/deploy/ did-base-sepolia --network base-sepolia",
    "deploy:base": "graph deploy --node https://api.studio.thegraph.com/deploy/ did-base --network base",
    "create-local": "graph create --node http://localhost:8020/ did-base-sepolia",
    "remove-local": "graph remove --node http://localhost:8020/ did-base-sepolia",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 did-base-sepolia",
    "test": "graph test -d"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.37.0"
  },
  "devDependencies": {
    "matchstick-as": "0.6.0"
  }
}
